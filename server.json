{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lvlrSajjad/sidecrew",
  "description": "Code changes and unit tests by local MLX models, behind a gate a machine can run.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/lvlrSajjad/sidecrew",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "sidecrew",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "valueHint": "mcp"
        }
      ]
    }
  ]
}
