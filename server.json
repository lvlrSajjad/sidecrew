{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.lvlrSajjad/sidecrew",
  "description": "Code changes and unit tests by local MLX models, behind a gate a machine can run.",
  "version": "0.1.0-rc.1",
  "repository": {
    "url": "https://github.com/lvlrSajjad/sidecrew",
    "source": "github"
  },
  "packages": [
    {
      "registry_type": "npm",
      "registry_base_url": "https://registry.npmjs.org",
      "identifier": "sidecrew",
      "version": "0.1.0-rc.1",
      "transport": {
        "type": "stdio"
      },
      "package_arguments": [
        {
          "type": "positional",
          "value": "mcp",
          "value_hint": "mcp"
        }
      ]
    }
  ]
}
